    "description": "Uzak adres var ama hiç başarılı tazeleme olmamış."
  },

  "feedSyncLast": "Son güncelleme: {relative}",
  "@feedSyncLast": {
    "placeholders": {
      "relative": { "type": "String", "example": "az önce" }
    }
  },

  "relativeJustNow": "az önce",
  "@relativeJustNow": {
    "description": "Bir dakikadan yeni. Gelecekteki damgalar da buraya düşer: cihaz saati geri alındığında '-3 saat önce' yazmak kullanıcının düzeltemeyeceği bir tuhaflık olurdu."
  },

  "relativeMinutes": "{count, plural, other{{count} dakika önce}}",
  "@relativeMinutes": {
    "placeholders": { "count": { "type": "int" } }
  },

  "relativeHours": "{count, plural, other{{count} saat önce}}",
  "@relativeHours": {
    "placeholders": { "count": { "type": "int" } }
  },

  "relativeDays": "{count, plural, other{{count} gün önce}}",
  "@relativeDays": {
    "placeholders": { "count": { "type": "int" } }
